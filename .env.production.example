# Copy to .env next to docker-compose.yml on the server and fill in every value.
# The API refuses to start in production with a missing or default JWT secret.

NODE_ENV=production

# openssl rand -base64 48
JWT_SECRET=
# Access tokens are short-lived; clients renew them with the refresh token.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

POSTGRES_PASSWORD=

# Never load demo accounts on a real database. Create the first super admin instead.
SEED_DEMO_DATA=false
BOOTSTRAP_ADMIN_EMAIL=
# At least 12 characters. Remove both lines after the first start if you like; an existing admin is never changed.
BOOTSTRAP_ADMIN_PASSWORD=

# Public base URL of the web host; image paths in API responses are prefixed with it.
PUBLIC_ASSET_URL=https://sportscity.example.com

# Browser origins allowed to call the API. Native mobile apps send no Origin and are unaffected.
CORS_ORIGINS=https://sportscity.example.com

# Proxy hops in front of the API (web nginx = 1, plus 1 for a load balancer or TLS terminator).
# Expose the API only through those proxies, otherwise clients can fake their IP for rate limits.
TRUST_PROXY=1
AUTH_RATE_LIMIT=10
API_RATE_LIMIT=300

# Live payment provider not connected yet: true keeps the simulated checkout.
TICKETING_SANDBOX_PAYMENTS=false

# OpenAPI docs at /api/docs. Set false to hide them.
API_DOCS=true
