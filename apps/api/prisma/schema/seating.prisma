// ---------------------------------------------------------------------------
// Ticketing extensions: stadium seating, box office, allocations, passes, cases
// ---------------------------------------------------------------------------

model VenueLayout {
  id          String   @id @default(uuid())
  reference   String   @unique
  status      String
  name        String
  venue       String
  capacity    Int      @default(0)
  notes       String   @default("")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stands Stand[]

  @@map("venue_layouts")
}

model Stand {
  id            String      @id @default(uuid())
  reference     String      @unique
  status        String
  name          String
  venueLayoutId String
  venueLayout   VenueLayout @relation(fields: [venueLayoutId], references: [id])
  gate          String
  capacity      Int         @default(0)
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  blocks SeatBlock[]

  @@map("stands")
}

model SeatBlock {
  id          String   @id @default(uuid())
  reference   String   @unique
  status      String
  name        String
  standId     String
  stand       Stand    @relation(fields: [standId], references: [id])
  rows        Int
  seatsPerRow Int
  capacity    Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seatRows SeatRow[]

  @@map("seat_blocks")
}

model SeatRow {
  id          String    @id @default(uuid())
  reference   String    @unique
  status      String
  label       String
  seatBlockId String
  seatBlock   SeatBlock @relation(fields: [seatBlockId], references: [id])
  seats       Int
  accessible  Int
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignments SeatAssignment[]

  @@unique([seatBlockId, label])
  @@map("seat_rows")
}

model SeatAssignment {
  id           String     @id @default(uuid())
  reference    String     @unique
  status       String
  matchEventId String
  matchEvent   MatchEvent @relation(fields: [matchEventId], references: [id])
  seatRowId    String
  seatRow      SeatRow    @relation(fields: [seatRowId], references: [id])
  seatNo       Int
  seatLabel    String     @default("")
  gate         String     @default("")
  allocation   String
  holder       String     @default("")
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([matchEventId, seatRowId, seatNo])
  @@map("seat_assignments")
}

model BoxOfficeTicket {
  id           String     @id @default(uuid())
  reference    String     @unique
  status       String
  matchEventId String
  matchEvent   MatchEvent @relation(fields: [matchEventId], references: [id])
  kind         String
  channel      String
  holder       String
  mobile       String
  quantity     Int
  priceBdt     Decimal    @db.Decimal(12, 2)
  seat         String     @default("")
  host         String     @default("")
  approvedBy   String     @default("")
  device       String     @default("")
  totalBdt     Decimal    @default(0) @db.Decimal(12, 2)
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([matchEventId, kind])
  @@map("box_office_tickets")
}

model TicketAllocation {
  id           String     @id @default(uuid())
  reference    String     @unique
  status       String
  matchEventId String
  matchEvent   MatchEvent @relation(fields: [matchEventId], references: [id])
  holderType   String
  holder       String
  quantity     Int
  contact      String
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("ticket_allocations")
}

model SeasonPass {
  id          String   @id @default(uuid())
  reference   String   @unique
  status      String
  holder      String
  mobile      String
  season      String
  seat        String   @default("")
  priceBdt    Decimal  @db.Decimal(12, 2)
  validUntil  DateTime @db.Date
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("season_passes")
}

model PromoCode {
  id              String      @id @default(uuid())
  reference       String      @unique
  status          String
  code            String      @unique
  matchEventId    String?
  matchEvent      MatchEvent? @relation(fields: [matchEventId], references: [id])
  discountPercent Int
  validUntil      DateTime    @db.Date
  usageLimit      Int
  used            Int         @default(0)
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("promo_codes")
}

model PriceChange {
  id               String         @id @default(uuid())
  reference        String         @unique
  status           String
  ticketCategoryId String
  ticketCategory   TicketCategory @relation(fields: [ticketCategoryId], references: [id])
  priceBdt         Decimal        @db.Decimal(12, 2)
  previousBdt      Decimal?       @db.Decimal(12, 2)
  reason           String         @default("")
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("price_changes")
}

model TicketTransfer {
  id            String      @id @default(uuid())
  reference     String      @unique
  status        String
  ticketOrderId String
  ticketOrder   TicketOrder @relation(fields: [ticketOrderId], references: [id])
  fromHolder    String      @default("")
  toHolder      String
  toMobile      String
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("ticket_transfers")
}

model TicketCase {
  id            String      @id @default(uuid())
  reference     String      @unique
  status        String
  /// REFUND or CANCELLATION
  kind          String
  ticketOrderId String
  ticketOrder   TicketOrder @relation(fields: [ticketOrderId], references: [id])
  amountBdt     Decimal?    @db.Decimal(12, 2)
  reason        String
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([kind, status])
  @@map("ticket_cases")
}

model EntryReview {
  id          String   @id @default(uuid())
  reference   String   @unique
  status      String
  gateId      String
  gate        Gate     @relation(fields: [gateId], references: [id])
  direction   String
  result      String
  note        String   @default("")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("entry_reviews")
}
