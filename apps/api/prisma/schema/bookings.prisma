// ---------------------------------------------------------------------------
// Booking extensions: slots, repeats, waitlist, coaches, add-ons, pricing, money
// ---------------------------------------------------------------------------

model Slot {
  id            String   @id @default(uuid())
  reference     String   @unique
  status        String
  facilityId    String
  facility      Facility @relation(fields: [facilityId], references: [id])
  dayOfWeek     String
  timeSlotStart String
  timeSlotEnd   String
  capacity      Int
  priceBdt      Decimal  @db.Decimal(12, 2)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([facilityId, dayOfWeek])
  @@map("slots")
}

model RecurringBookingRule {
  id            String   @id @default(uuid())
  reference     String   @unique
  status        String
  facilityId    String
  facility      Facility @relation(fields: [facilityId], references: [id])
  customerName  String
  type          String
  frequency     String
  startsOn      DateTime @db.Date
  endsOn        DateTime @db.Date
  timeSlotStart String
  timeSlotEnd   String
  amountBdt     Decimal  @db.Decimal(12, 2)
  generated     Int      @default(0)
  skipped       Int      @default(0)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("recurring_booking_rules")
}

model WaitlistEntry {
  id            String   @id @default(uuid())
  reference     String   @unique
  status        String
  facilityId    String
  facility      Facility @relation(fields: [facilityId], references: [id])
  customerName  String
  phone         String
  preferredDate DateTime @db.Date
  timeSlotStart String
  timeSlotEnd   String
  amountBdt     Decimal  @db.Decimal(12, 2)
  /// Booking made when the offer was converted.
  bookingId     String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([facilityId, status])
  @@map("waitlist_entries")
}

model Coach {
  id            String   @id @default(uuid())
  reference     String   @unique
  status        String
  name          String
  sport         String
  phone         String
  hourlyRateBdt Decimal  @db.Decimal(12, 2)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions CoachSession[]

  @@map("coaches")
}

model CoachSession {
  id            String   @id @default(uuid())
  reference     String   @unique
  status        String
  coachId       String
  coach         Coach    @relation(fields: [coachId], references: [id])
  facilityId    String
  facility      Facility @relation(fields: [facilityId], references: [id])
  customerName  String
  sessionDate   DateTime @db.Date
  timeSlotStart String
  timeSlotEnd   String
  amountBdt     Decimal  @default(0) @db.Decimal(12, 2)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([coachId, sessionDate])
  @@map("coach_sessions")
}

model BookingAddOn {
  id          String    @id @default(uuid())
  reference   String    @unique
  status      String
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id])
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  quantity    Int
  feeBdt      Decimal   @db.Decimal(12, 2)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("booking_add_ons")
}

model PricingRule {
  id            String    @id @default(uuid())
  reference     String    @unique
  status        String
  name          String
  /// PEAK or DYNAMIC
  kind          String
  facilityId    String?
  facility      Facility? @relation(fields: [facilityId], references: [id])
  dayOfWeek     String
  startsAt      String
  endsAt        String
  adjustPercent Int
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([kind, status])
  @@map("pricing_rules")
}

model BookingDeposit {
  id          String   @id @default(uuid())
  reference   String   @unique
  status      String
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  amountBdt   Decimal  @db.Decimal(12, 2)
  method      String
  heldOn      DateTime @db.Date
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("booking_deposits")
}

model CancellationPolicy {
  id            String   @id @default(uuid())
  reference     String   @unique
  status        String
  name          String
  facilityType  String
  hoursBefore   Int
  refundPercent Int
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("cancellation_policies")
}

model BookingPayment {
  id          String   @id @default(uuid())
  reference   String   @unique
  status      String
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  amountBdt   Decimal  @db.Decimal(12, 2)
  method      String
  gatewayRef  String   @default("")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bookingId, status])
  @@map("booking_payments")
}
